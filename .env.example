# Copy to .env for `docker compose`. Generate tokens with: openssl rand -hex 32

# Shared secret between the app and its region agent (required).
OBS_REGIONS_TOKEN=
# Lets the UI import, update and delete regions; empty = read-only.
OBS_ADMIN_TOKEN=
# Contact URL or address sent to OpenStreetMap services and Geofabrik.
OBS_CONTACT=
# Largest extract the agent downloads, MB (a whole country can be several GB).
OBS_REGIONS_MAX_DOWNLOAD_MB=2048
# Re-import ready regions after this many days (0 = never).
OBS_REGIONS_REFRESH_DAYS=7
