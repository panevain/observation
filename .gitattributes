# Normalize line endings: LF in the repo, LF in the working tree.
* text=auto eol=lf

# Scripts must stay LF so shebangs work on every platform.
*.sh text eol=lf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.wasm binary
fuzz/seeds/**/* binary

# Lockfiles are generated: collapse in diffs, never merge textually.
Cargo.lock linguist-generated=true -diff
fuzz/Cargo.lock linguist-generated=true -diff
mise.lock linguist-generated=true -diff

# Build artifacts excluded from language stats and diffs.
/dist/** linguist-generated=true
/target/** linguist-generated=true
