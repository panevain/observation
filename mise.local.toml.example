# Copy to mise.local.toml (gitignored) and edit.
[env]
# Goes into the User-Agent sent to OpenStreetMap services: set a real contact.
OBS_CONTACT = "CHANGE-ME@example.com"
# The server binds 0.0.0.0:8080 by default. Uncomment to listen on loopback only.
# OBS_BIND = "127.0.0.1:8080"
# Overpass interpreters, tried in order when one fails or times out (at most 4).
# OBS_OVERPASS_URL = "https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter"

# Docker Compose (`mise run up`) reads the rest of this file. Its tokens
# (OBS_REGIONS_TOKEN, OBS_ADMIN_TOKEN) are fnox secrets: see fnox.toml.
# Host port for the app (default 8080).
# OBS_PORT = "8080"
# `json` for one JSON object per log line (default `text`).
# OBS_LOG_FORMAT = "json"
# Largest Geofabrik extract downloaded, MB (default 2048).
# OBS_REGIONS_MAX_DOWNLOAD_MB = "2048"
# Re-import regions after this many days; 0 never (default 7).
# OBS_REGIONS_REFRESH_DAYS = "7"
